// ============================================
// Prisma 스키마 정의 파일
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  todos     Todo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  isDone    Boolean  @default(false)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  // ✏️ TODO-3: Todo 쪽에서도 Tag 들을 가리키는 가상 필드를 추가해야 N:M 이 성립해요.
  //   힌트: 양쪽 모두 배열 필드 — Tag[] 형태. 외래 키는 안 만들어도 돼요(중간 테이블은 Prisma 가 자동 생성).
  tags      ___[]                                            // ← TODO-3

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("todos")
}

// ✏️ TODO-1: Tag 모델의 name 은 중복되면 안 돼요. (같은 이름의 태그가 두 개 있으면 헷갈리겠죠?)
//   "이 컬럼은 unique 다" 를 표시하는 Prisma 속성은? (@id / @unique / @default 중)
// ✏️ TODO-2: Tag 쪽에서도 이 Tag 가 붙어 있는 Todo 들을 가리키는 가상 필드가 필요해요.
//   힌트: 1:N 의 1쪽 면과 똑같이 ___[] 형태.
model Tag {
  id    Int    @id @default(autoincrement())
  name  String ___                                           // ← TODO-1
  todos ___[]                                                // ← TODO-2

  @@map("tags")
}
