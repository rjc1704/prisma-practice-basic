// ============================================
// Prisma 스키마 정의 파일
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String

  // ✏️ TODO-1: 이 User 가 가진 Todo 목록을 가리키는 가상 필드를 추가하세요.
  //   힌트: `필드명  ___[]` 형태. 1:N 의 1쪽 면은 항상 배열 타입이에요.
  //         실제 DB 컬럼은 안 생기고, include 할 때만 쓰입니다.
  todos     ___[]                                            // ← TODO-1

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  isDone    Boolean  @default(false)

  // ✏️ TODO-2: 1:N 의 N쪽 면을 완성하세요. 외래 키(userId) 는 이미 채워져 있어요.
  //   아래 user 필드의 @relation 안 ___ 두 곳을 채우면 됩니다.
  //   힌트: "이 Todo 의 어떤 필드(___) 를 users 테이블의 어떤 필드(___) 와 연결할까?"
  userId    Int
  user      User     @relation(fields: [___], references: [___])   // ← TODO-2

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("todos")
}
