// ============================================
// Prisma 스키마 정의 파일
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  todos     Todo[]

  // ✏️ TODO-1: User 와 Profile 의 1:1 관계 — 사용자는 프로필을 가질 수도 / 안 가질 수도.
  //   힌트: 1:N 의 1쪽이 `Profile[]` 이었다면, 1:1 의 1쪽은 단수 + "선택적" 표시가 붙어요.
  //         (단수형 + 물음표(?))
  profile   ___                                              // ← TODO-1

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  isDone    Boolean  @default(false)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  tags      Tag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("todos")
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  todos Todo[]

  @@map("tags")
}

// ✏️ TODO-2: Profile 의 외래 키(userId) 에 "이게 1:1 이다" 를 표시하는 속성은?
//   힌트: 한 사용자는 프로필 하나만! → 같은 userId 가 두 행에 있을 수 없음.
//          1:N 의 N쪽과 비교했을 때 딱 한 단어가 추가됩니다.
model Profile {
  id        Int     @id @default(autoincrement())
  bio       String?
  avatarUrl String?
  userId    Int     ___                                      // ← TODO-2
  user      User    @relation(fields: [userId], references: [id])

  @@map("profiles")
}
