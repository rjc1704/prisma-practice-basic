// ============================================
// Prisma 스키마 정의 파일
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String

  // 1:N 의 1쪽 면 — 가상 필드. DB 컬럼은 안 생기고 include 할 때만 쓰임.
  todos     Todo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  isDone    Boolean  @default(false)

  // 1:N 의 N쪽 면 — 실제 외래 키 컬럼 + @relation 메타.
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("todos")
}
