// ============================================
// Prisma 스키마 정의 파일
// ============================================
//
// 이 파일이 우리 DB 구조의 "설계도"입니다.
// 모델을 정의하고 `npx prisma migrate dev`를 실행하면
// Prisma가 SQL을 만들어 DB에 테이블을 생성해줘요.
//
// 💡 generator 와 datasource 블록은 `npx prisma init` 으로 자동 생성된
//    부분이라 그대로 둡니다. 우리는 model 만 추가해 나가면 돼요.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


