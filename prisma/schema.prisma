// ============================================
// Prisma 스키마 정의 파일
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  todos     Todo[]
  profile   Profile?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id        Int     @id @default(autoincrement())
  bio       String?
  avatarUrl String?
  userId    Int     @unique
  user      User    @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  isDone    Boolean  @default(false)

  // 1:N 의 N쪽 면 — 실제 외래 키 컬럼 + @relation 메타.
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  // N:M — Tag 양쪽 모두 배열 필드. 외래 키 없음(_TodoToTag 중간 테이블 자동 생성).
  tags      Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("todos")
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  todos Todo[]

  @@map("tags")
}
